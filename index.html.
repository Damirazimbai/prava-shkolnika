<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Мои права в школе</title>
<style>
:root{--ink:#18213b;--muted:#65708b;--bg:#f5f7ff;--purple:#7357ff;--pink:#ff6ca8;--blue:#45b7ff;--yellow:#ffd45c;--green:#48c9a1}
*{box-sizing:border-box} body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);background:var(--bg)}
header{padding:22px 6vw 70px;background:radial-gradient(circle at 85% 15%,#ffb5d0 0 9%,transparent 10%),linear-gradient(125deg,#6e57ff,#9b75ff 55%,#55c6ff);color:white;overflow:hidden}
nav{display:flex;justify-content:space-between;align-items:center;max-width:1100px;margin:auto}
.logo{font-weight:900;letter-spacing:.4px}.tag{background:#ffffff25;border:1px solid #ffffff55;padding:8px 13px;border-radius:99px;font-size:13px}
.hero{max-width:1100px;margin:65px auto 0;display:grid;grid-template-columns:1.25fr .75fr;gap:25px;align-items:center}
h1{font-size:clamp(38px,6vw,68px);line-height:1.02;margin:0 0 18px;letter-spacing:-2px}.hero p{font-size:18px;line-height:1.6;max-width:610px;color:#f5f2ff}
.hero-art{background:#ffffff20;border:1px solid #ffffff55;border-radius:32px;padding:25px;text-align:center;transform:rotate(2deg)}
.hero-art .emoji{font-size:90px}.hero-art strong{display:block;font-size:20px;margin-top:8px}
main{max-width:1100px;margin:-32px auto 0;padding:0 22px 60px;position:relative}
.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:45px}
.quick div{background:white;padding:18px 20px;border-radius:20px;box-shadow:0 12px 30px #26315c12}.quick b{font-size:25px;display:block}.quick span{color:var(--muted);font-size:13px}
.section-head{display:flex;justify-content:space-between;gap:15px;align-items:end;margin:38px 0 18px}.section-head h2{font-size:30px;margin:0}.section-head p{color:var(--muted);margin:0}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.card{background:white;border-radius:23px;padding:22px;min-height:205px;box-shadow:0 10px 28px #26315c0d;border:1px solid #edf0fa}
.card .icon{width:52px;height:52px;border-radius:16px;display:grid;place-items:center;font-size:27px;margin-bottom:16px}
.card h3{margin:0 0 9px;font-size:19px}.card p{margin:0;color:var(--muted);line-height:1.55;font-size:14px}
.purple{background:#eeeaff}.pink{background:#ffe8f1}.blue{background:#e5f5ff}.yellow{background:#fff5d8}.green{background:#e3faf3}.lavender{background:#f1eaff}
.callout{margin:36px 0;background:#1e2850;color:white;border-radius:25px;padding:27px 30px;display:flex;gap:20px;align-items:center}.callout .big{font-size:42px}.callout p{margin:7px 0 0;color:#d5dcff;line-height:1.5}
.quiz{background:white;border-radius:26px;padding:26px;box-shadow:0 10px 28px #26315c0d}.qtop{display:flex;justify-content:space-between;color:var(--muted);font-size:13px}.qtext{font-size:22px;font-weight:800;margin:22px 0}
.answers{display:grid;grid-template-columns:1fr 1fr;gap:10px}.answer{background:#f5f6fc;border:2px solid transparent;border-radius:15px;padding:14px;text-align:left;font:inherit;color:var(--ink);cursor:pointer;transition:.15s}.answer:hover{border-color:#b8aaff}.answer:disabled{cursor:default;opacity:1}.answer.correct{background:#e2f8ef;border-color:#48c9a1}.answer.wrong{background:#fff0f2;border-color:#ff8ba6}
.feedback{min-height:28px;margin-top:15px;font-weight:700}.next{background:var(--purple);color:white;border:0;border-radius:13px;padding:12px 18px;font-weight:800;cursor:pointer;display:none}
footer{text-align:center;padding:30px 20px 45px;color:var(--muted);font-size:13px}footer a{color:var(--purple)}
@media(max-width:760px){.hero{grid-template-columns:1fr;margin-top:42px}.hero-art{display:none}.quick{grid-template-columns:1fr 1fr}.cards{grid-template-columns:1fr 1fr}.section-head{display:block}.section-head p{margin-top:7px}}
@media(max-width:480px){header{padding-bottom:60px}.quick{grid-template-columns:1fr 1fr}.cards{grid-template-columns:1fr}.answers{grid-template-columns:1fr}.callout{align-items:flex-start;padding:22px}.callout .big{font-size:32px}}
</style>
</head>
<body>
<header>
<nav><div class="logo">⚖️ SCHOOL RIGHTS</div><div class="tag">Твой голос имеет значение</div></nav>
<div class="hero">
 <div><h1>Твои права.<br>Твоя школа.</h1><p>Разбираемся, на что ты имеешь право в школе, как защитить себя и почему уважение работает в обе стороны.</p></div>
 <div class="hero-art"><div class="emoji">🎓✨</div><strong>Знай. Спрашивай. Действуй.</strong><p style="margin:8px 0 0;color:#fff">Мини-гид для школьников</p></div>
</div>
</header>
<main>
 <div class="quick">
  <div><b>📚 Учись</b><span>Право на образование</span></div>
  <div><b>🗣️ Говори</b><span>Твоё мнение важно</span></div>
  <div><b>🛡️ Будь в безопасности</b><span>Уважение и защита</span></div>
 </div>
 <div class="section-head"><div><h2>На что ты имеешь право?</h2><p>Коротко и понятным языком</p></div></div>
 <div class="cards">
  <article class="card"><div class="icon purple">📖</div><h3>На образование</h3><p>Ты имеешь право получать качественное образование. В Казахстане гарантировано бесплатное начальное, основное среднее и общее среднее образование.</p></article>
  <article class="card"><div class="icon pink">💬</div><h3>На своё мнение</h3><p>Ты можешь выражать мнение и задавать вопросы уважительным способом. Твоё мнение важно при обсуждении вопросов, которые тебя касаются.</p></article>
  <article class="card"><div class="icon blue">🛡️</div><h3>На безопасность</h3><p>Ты имеешь право на защиту от насилия, травли, унижения и опасной обстановки. В школе важно создавать безопасную среду.</p></article>
  <article class="card"><div class="icon yellow">🤝</div><h3>На равное отношение</h3><p>Все дети равны в правах. Нельзя унижать или исключать человека из-за языка, происхождения, пола, здоровья или других особенностей.</p></article>
  <article class="card"><div class="icon green">🌱</div><h3>На развитие</h3><p>Ты можешь развивать таланты, участвовать в школьных проектах, творческих и общественных мероприятиях.</p></article>
  <article class="card"><div class="icon lavender">🔐</div><h3>На уважение</h3><p>Твои честь и достоинство должны уважаться. Нельзя оправдывать оскорбления словами «это просто шутка».</p></article>
 </div>
 <div class="callout"><div class="big">💡</div><div><strong>А если твои права нарушают?</strong><p>Обратись к взрослому, которому доверяешь: родителю, классному руководителю, школьному психологу или администрации. Если ситуация серьёзная — попроси взрослого помочь обратиться в компетентные службы.</p></div></div>
 <div class="section-head"><div><h2>Права или обязанности?</h2><p>Проверь себя в мини-викторине</p></div></div>
 <section class="quiz" aria-live="polite">
  <div class="qtop"><span id="counter">Вопрос 1 из 5</span><span>⚡ QUIZ TIME</span></div>
  <div class="qtext" id="question">Может ли ученик уважительно высказывать своё мнение о школьной жизни?</div>
  <div class="answers" id="answers"></div>
  <div class="feedback" id="feedback"></div>
  <button class="next" id="next">Следующий вопрос →</button>
 </section>
 <div class="section-head"><div><h2>Помни и о своих обязанностях</h2><p>Права каждого человека заканчиваются там, где начинаются права другого</p></div></div>
 <div class="cards">
  <article class="card"><div class="icon yellow">📏</div><h3>Соблюдай правила</h3><p>Следуй уставу школы и установленным правилам, не мешая другим учиться.</p></article>
  <article class="card"><div class="icon green">🫶</div><h3>Уважай других</h3><p>Уважай права, свободы, честь и достоинство одноклассников и работников школы.</p></article>
  <article class="card"><div class="icon blue">🏫</div><h3>Береги школу</h3><p>Бережно относись к учебникам, оборудованию и школьному имуществу.</p></article>
 </div>
</main>
<footer>Информационный проект школьного парламента · «Заң және тәртіп»<br><br>
Материалы: Закон РК «О правах ребёнка» и Закон РК «Об образовании».<br>
<a href="https://adilet.zan.kz/rus/docs/Z020000345_" target="_blank" rel="noopener">Закон о правах ребёнка</a> ·
<a href="https://www.gov.kz/org/edu/documents/details/734?lang=ru" target="_blank" rel="noopener">Закон об образовании</a><br><br>
Учебный материал. Для конкретной ситуации уточняй нормы закона и обращайся за помощью к взрослому.
</footer>
<script>
const quiz=[
 {q:"Может ли ученик уважительно высказывать своё мнение о школьной жизни?",a:["Да, это его право","Нет, мнение могут иметь только взрослые"],c:0,e:"Да! Ребёнок имеет право выражать своё мнение и участвовать в общественной жизни."},
 {q:"Что делать, если одноклассника регулярно травят?",a:["Снимать это ради просмотров","Сообщить взрослому, которому доверяешь"],c:1,e:"Верно. О травле важно сообщить взрослому и попросить помощи."},
 {q:"Все ли дети имеют равные права?",a:["Да, независимо от происхождения и других особенностей","Только отличники"],c:0,e:"Да. Равноправие детей закреплено законом."},
 {q:"Что относится к обязанности ученика?",a:["Унижать тех, кто не согласен","Уважать права и достоинство других"],c:1,e:"Правильно. Уважение к другим — одна из обязанностей ребёнка."},
 {q:"Гарантировано ли в Казахстане бесплатное общее среднее образование?",a:["Да","Нет"],c:0,e:"Да. Это закреплено Законом РК «О правах ребёнка»."}
];
let index=0,score=0,locked=false;
const q=document.getElementById('question'),answers=document.getElementById('answers'),feedback=document.getElementById('feedback'),next=document.getElementById('next'),counter=document.getElementById('counter');
function render(){locked=false;let item=quiz[index];counter.textContent=`Вопрос ${index+1} из ${quiz.length}`;q.textContent=item.q;feedback.textContent="";next.style.display="none";answers.innerHTML="";
item.a.forEach((value,i)=>{let b=document.createElement('button');b.className='answer';b.textContent=value;b.onclick=()=>choose(i);answers.appendChild(b)})}
function choose(choice){if(locked)return;locked=true;let item=quiz[index];[...answers.children].forEach((b,i)=>{b.disabled=true;if(i===item.c)b.classList.add('correct');else if(i===choice)b.classList.add('wrong')});if(choice===item.c){score++;feedback.textContent="✅ Верно! "+item.e}else{feedback.textContent="💡 Попробуй запомнить: "+item.e}next.textContent=index===quiz.length-1?"Посмотреть результат →":"Следующий вопрос →";next.style.display="inline-block"}
next.onclick=()=>{if(index<quiz.length-1){index++;render()}else{q.textContent=`Ты ответил(а) правильно на ${score} из ${quiz.length} вопросов!`;answers.innerHTML="";feedback.textContent=score===5?"Отличный результат! Ты знаешь свои права. 🎉":"Хорошее начало! Перечитай карточки и попробуй ещё раз.";next.textContent="Пройти заново ↻";next.onclick=()=>{index=0;score=0;render();next.onclick=advance}}};
function advance(){if(index<quiz.length-1){index++;render()}else{q.textContent=`Ты ответил(а) правильно на ${score} из ${quiz.length} вопросов!`;answers.innerHTML="";feedback.textContent="Молодец, что изучаешь свои права!";next.textContent="Пройти заново ↻";next.onclick=()=>{index=0;score=0;render();next.onclick=advance}}}
next.onclick=advance;render();
</script>
</body>
</html>
